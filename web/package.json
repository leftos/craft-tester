{
  "name": "craft-tester-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schema:export": "node scripts/export-schema.ts",
    "propose": "node scripts/propose.ts",
    "check:browser": "node scripts/browser-check.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "happy-dom": "21.0.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.26.1"
}
